{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://after-glow.duckdns.org",
        "EXPO_PUBLIC_AI_API_URL": "https://after-glow-ml.duckdns.org",
        "EXPO_PUBLIC_BUILDINGS_PMTILES_URL": "https://after-glow.duckdns.org/data/buildings.pmtiles"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6808603701"
      }
    }
  }
}
