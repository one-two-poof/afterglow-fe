# Expo 공개 환경변수 (EXPO_PUBLIC_ 접두사만 클라이언트 번들에 인라인됨).
# 이 파일을 `.env`로 복사해 값을 채운다. `.env`는 커밋하지 않는다.

# 메인 BE
EXPO_PUBLIC_API_URL=https://api.example.com

# ML 추천 서버
EXPO_PUBLIC_AI_API_URL=https://ai.example.com

# 건물 PMTiles 타일 URL (지도, PR 14~)
EXPO_PUBLIC_BUILDINGS_PMTILES_URL=https://tiles.example.com/buildings.pmtiles
