auto-install-peers=true
strict-peer-dependencies=false
# RN/Expo 툴체인(EAS의 entitlements 해석 등)이 최상위에서 expo-modules-autolinking을
# 못 찾는 문제 해결: expo/react-native 관련 패키지만 루트로 호이스트한다.
# node-linker=hoisted(flat)는 apps/mobile(react 19.2.3 고정)과 web/admin/ui(^19.2.8)의
# react 버전이 섞여 테스트가 깨지므로 쓰지 않고, 격리형을 유지한 채 선택 호이스트만 한다.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
